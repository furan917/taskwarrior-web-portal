package views

templ MergeTagFormModal(csrf, fromTag string, allTags []string) {
	@modalShell("task-modal") {
		@modalHeader("Merge tag")
		<form
			hx-post={ "/tags/" + fromTag + "/merge" }
			hx-target-error="#merge-form-errors"
			hx-swap="none"
		>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<div class="flex flex-col gap-4 p-4">
				<div class="text-sm">
					<span class="font-medium text-zinc-700 dark:text-zinc-300">From</span>
					<div class="mt-1">
						<code class="inline-flex items-center rounded bg-zinc-100 px-2 py-0.5 text-sm text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200">+{ fromTag }</code>
					</div>
				</div>
				<label class="block text-sm">
					<span class="font-medium text-zinc-700 dark:text-zinc-300">Into</span>
					<div class="mt-1">
						@acField("to", "", "Type to search tags...", "single", mergeTagOptions(allTags, fromTag))
					</div>
				</label>
				<p class="text-xs text-amber-700 dark:text-amber-400">
					This affects all pending and waiting tasks with this tag.
				</p>
				<p class="text-xs text-zinc-500 dark:text-zinc-400">
					Move all tasks with +{ fromTag } to another tag, then remove +{ fromTag }.
				</p>
				<div id="merge-form-errors" class="empty:hidden rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-800 dark:bg-red-950/40 dark:text-red-300"></div>
			</div>
			<div class="flex items-center justify-end gap-2 border-t border-zinc-200 px-4 py-3 dark:border-zinc-700">
				<button type="button" data-dismiss-modal class="rounded px-3 py-1.5 text-sm text-zinc-600 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-zinc-800">Cancel</button>
				<button type="submit" data-close-on-success class="rounded bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-zinc-950">Merge</button>
			</div>
		</form>
	}
}

func mergeTagOptions(tags []string, exclude string) []acOption {
	opts := make([]acOption, 0, len(tags))
	for _, t := range tags {
		if t != exclude {
			opts = append(opts, acOption{Value: t, Text: t})
		}
	}
	return opts
}
