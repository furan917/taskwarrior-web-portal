package views

import "github.com/furan917/taskwarrior-web-portal/internal/tw"

templ ManageUDAsPage(p Page, udas []tw.UDA) {
	@Layout(p) {
		<div class="mb-4 flex items-center justify-between">
			<h2 class="text-lg font-medium">User-defined Attributes</h2>
			<button
				type="button"
				hx-get="/forms/uda/new"
				hx-target="#modal"
				class="rounded bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-zinc-950"
			>+ New UDA</button>
		</div>
		if len(udas) == 0 {
			<div class={ EmptyCardClass() + " p-12 text-center" }>
				<p class="text-sm text-zinc-500 dark:text-zinc-400">No UDAs defined yet.</p>
				<p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">User-defined attributes let you attach custom fields to tasks.</p>
			</div>
		} else {
			<div class={ CardClass() + " overflow-hidden" }>
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-zinc-200 bg-zinc-50 text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-400">
							<th class="px-3 py-2 text-left">Name</th>
							<th class="px-3 py-2 text-left">Type</th>
							<th class="hidden px-3 py-2 text-left sm:table-cell">Label</th>
							<th class="hidden px-3 py-2 text-left sm:table-cell">Values</th>
							<th class="px-3 py-2"></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
						for _, u := range udas {
							@udaManageRow(u)
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ udaManageRow(u tw.UDA) {
	<tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/40">
		<td class="px-3 py-2 font-mono font-medium text-zinc-800 dark:text-zinc-200">
			{ u.Name }
			if u.BuiltIn {
				<span class="ml-1.5 inline-flex items-center rounded bg-zinc-100 px-1.5 py-0.5 text-[10px] font-medium text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">built-in</span>
			}
		</td>
		<td class="px-3 py-2 text-zinc-600 dark:text-zinc-400">{ configOrDefault(u.Type, "string") }</td>
		<td class="hidden px-3 py-2 text-zinc-600 dark:text-zinc-400 sm:table-cell">{ configOrDefault(u.Label, u.Name) }</td>
		<td class="hidden px-3 py-2 text-zinc-500 dark:text-zinc-500 sm:table-cell">{ udaValuesText(u.Values) }</td>
		<td class="px-3 py-2">
			if !u.BuiltIn {
				<div class="flex items-center justify-end gap-2">
					<button
						type="button"
						hx-get={ "/forms/uda/" + u.Name }
						hx-target="#modal"
						class="text-xs text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
					>Edit</button>
					<button
						type="button"
						hx-delete={ "/udas/" + u.Name }
						hx-confirm={ "Delete UDA '" + u.Name + "'? Tasks with this field will keep their values but the field will no longer be recognised." }
						hx-swap="none"
						class="text-xs text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
					>Delete</button>
				</div>
			}
		</td>
	</tr>
}
